{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		":automergeBranch",
		":automergeMinor",
		":automergeRequireAllStatusChecks",
		":combinePatchMinorReleases",
		":dependencyDashboard",
		":maintainLockFilesDisabled"
	],
	"enabledManagers": [
		"bun",
		"github-actions"
	],
	"schedule": [
		"every weekend"
	]
}
